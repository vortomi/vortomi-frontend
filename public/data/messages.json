  { "id": "msg_v_adriana_1", "tenantId": "ten_valle", "conversationId": "cnv_v_adriana", "direction": "inbound", "type": "text", "body": "Buenos días, ¿hacen comedores a medida? Necesito uno de 6 puestos para un espacio de 1,80 m.", "authorUserId": null, "templateId": null, "status": null, "createdAt": "2026-10-09T09:40:00-04:00" },
  { "id": "msg_v_adriana_2", "tenantId": "ten_valle", "conversationId": "cnv_v_adriana", "direction": "outbound", "type": "text", "body": "Buenos días Adriana, sí. El comedor de 6 puestos a medida sale en 680 $ y tarda unas 3 semanas.", "authorUserId": "usr_andres", "templateId": null, "status": "read", "createdAt": "2026-10-09T09:52:00-04:00" },
