  { "id": "msg_v_adriana_4", "tenantId": "ten_valle", "conversationId": "cnv_v_adriana", "direction": "outbound", "type": "text", "body": "Sí, es pino macizo tratado. Te esperamos en la tienda de 9 am a 6 pm, tenemos uno de muestra.", "authorUserId": "usr_andres", "templateId": null, "status": "read", "createdAt": "2026-10-09T10:12:00-04:00" },
